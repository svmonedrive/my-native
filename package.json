{
  "name": "my-native",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "create:host:app": "node scripts/create-app.mjs host",
    "create:service:app": "node scripts/create-app.mjs service",
    "start:service:trendhub": "ng serve trendhub-app --port 6201",
    "start:service:matrimony": "ng serve matrimony-app --port 6202",
    "start:service:landhub": "ng serve landhub-app --port 6203",
    "start:service:doctors": "ng serve doctors-app --port 6204",
    "start:host:kakdwip": "ng serve kakdwip-app --port 7201",
    "start:host:namkhana": "ng serve namkhana-app --port 7202",
    "start": "concurrently -k -n trendhub,matrimony,landhub,doctors,kakdwip,namkhana \"npm:start:service:trendhub\" \"npm:start:service:matrimony\" \"npm:start:service:landhub\" \"npm:start:service:doctors\" \"npm:start:host:kakdwip\" \"npm:start:host:namkhana\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:pages": "node scripts/build-pages.mjs",
    "deploy": "npm run build:pages && angular-cli-ghpages --dir=dist/pages --no-notfound"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.1.0",
    "concurrently": "^10.0.7",
    "firebase": "^13.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.0",
    "angular-cli-ghpages": "^3.1.2",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
